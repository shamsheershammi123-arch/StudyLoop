# ==========================================
# StudyLoop Environment Configuration
# ==========================================

# 1. Google Gemini API (Server-side only)
# Required for agentic AI material extraction, plan recovery, and focus coach insights.
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Configuration (Optional - for remote cloud persistent Postgres & Auth)
# If omitted or left as placeholder, StudyLoop seamlessly uses its built-in local persistent store.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

